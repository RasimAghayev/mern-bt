# Build context exclusions. The image carries the source, so only the runtime
# state of the stack and the local tooling are left out.
.git
.github
node_modules
coverage
.nyc_output
tmp
logs
*.log
npm-debug.log*

# Local configuration overrides of the `config` package. They can hold a
# credential, so they never enter an image.
config/local.json
config/production.json

# The local environment file. It holds the values of the machine and must
# never be baked into an image.
.env
.env.*
!.env.example

# Runtime state of the compose stack (R92).
var

command.txt
