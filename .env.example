# Copy this file to .env and fill in the values for your machine.
# .env is ignored by git. Never commit a real credential.
#
# The same values can be supplied through config/local.json, which is also
# ignored by git, or through the environment of the process that starts the
# server. The environment wins over both.

# MongoDB connection string. Required when NODE_ENV=production.
MONGODB_URI=mongodb://127.0.0.1:27017/social-network-api

# Secret used to sign and verify JSON Web Tokens. Required when
# NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-generated-random-value

# Port the HTTP server listens on.
PORT=5000

# Use "production" to require MONGODB_URI and JWT_SECRET to be set. The
# server refuses to start when either one is missing or still a placeholder.
NODE_ENV=development
